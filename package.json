    "./client": {
      "types": "./priv/static/storehouse-client.d.mts",
      "import": "./priv/static/storehouse-client.mjs"
    }
  },
  "files": [
    "priv/static/storehouse.js",
    "priv/static/storehouse.cjs.js",
    "priv/static/storehouse-client.mjs",
    "priv/static/storehouse-client.d.mts",
    "README.md",
    "LICENSE"
