{
  "name": "@hattoriai/storehouse",
  "version": "0.1.0",
  "description": "Files for Phoenix: the uploader of Storehouse's direct uploads for LiveView, and an upload client for any frontend.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hattoriai/storehouse.git"
  },
  "homepage": "https://github.com/hattoriai/storehouse",
  "module": "./priv/static/storehouse.js",
  "main": "./priv/static/storehouse.cjs.js",
  "exports": {
    ".": {
      "import": "./priv/static/storehouse.js",
